{
  "schema_version": "1.0.0",
  "inputs": [
    {
      "name": "value",
      "schema": {
        "type": "string"
      }
    }
  ],
  "output": {
    "schema": {
      "type": "object"
    }
  },
  "errors": [
    {
      "type": "TypeError",
      "when": "value is not a string"
    },
    {
      "type": "ValueError",
      "when": "JSON is invalid, duplicated, or not an object"
    }
  ],
  "effects": []
}
