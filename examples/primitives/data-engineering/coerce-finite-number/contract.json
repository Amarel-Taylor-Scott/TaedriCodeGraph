{
  "schema_version": "1.0.0",
  "inputs": [
    {
      "name": "value",
      "schema": {
        "type": "string"
      }
    }
  ],
  "output": {
    "schema": {
      "type": "number"
    }
  },
  "errors": [
    {
      "type": "TypeError",
      "when": "value is not a string"
    },
    {
      "type": "ValueError",
      "when": "value is empty, non-numeric, or non-finite"
    }
  ],
  "effects": []
}
