{
  "schema_version": "1.0.0",
  "layout_state": "transitional",
  "invariants": [
    "canonical facts never depend on disposable search indexes",
    "component dependencies form a directed acyclic graph",
    "schemas and the kernel do not depend on services, integrations, or apps",
    "ingestion does not import or execute analyzed target code",
    "similarity candidates never become compatibility proof"
  ],
  "components": [
