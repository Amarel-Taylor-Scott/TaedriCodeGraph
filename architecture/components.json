{
  "schema_version": "1.0.0",
  "layout_state": "transitional",
  "invariants": [
    "canonical facts never depend on disposable search indexes",
    "component dependencies form a directed acyclic graph",
    "schemas and the kernel do not depend on services, integrations, or apps",
    "ingestion does not import or execute analyzed target code",
    "similarity candidates never become compatibility proof",
    "sealed benchmark tasks, tests, gold outputs, and answer-derived features never enter production retrieval",
    "primitive revisions are immutable and branch refs never participate in content identity",
    "staged and curated candidates never enter public primitive search, resolution, or pack delivery",
    "component status is an evidence-backed readiness state, never a roadmap label"
