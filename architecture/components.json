      "depends_on": []
    },
    {
      "id": "shared-schemas",
      "path": "packages/shared-schemas",
      "kind": "library-and-registry",
      "status": "scaffolded",
      "owns": ["descriptor schemas", "predicate schemas", "registry manifests", "conformance fixtures"],
      "depends_on": ["shared-kernel"]
    },
    {
      "id": "schema-artifacts",
      "path": "schemas",
