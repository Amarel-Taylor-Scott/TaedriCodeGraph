        {"ordinal": 5, "name": "accept", "policy": "complete_capsule_and_executable_proofs_fail_closed", "outputs": ["acceptance_receipt", "materialization_receipt"]},
        {"ordinal": 6, "name": "release", "policy": "assurance_tier_separation_dedup_query_and_authorization", "outputs": ["primitive_release"]},
        {"ordinal": 7, "name": "project", "policy": "active_releases_only_continue_rebuildable", "outputs": ["exact", "lexical", "scalar", "blocking", "vector", "graph", "downloadable_pack"]}
