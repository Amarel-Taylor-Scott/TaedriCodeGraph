{
  "schema_version": "1.0.0",
  "as_of": "2026-07-16",
  "decision": "one versioned mechanism contract, seven policy-specific waterfalls",
  "invariants": [
    "exact facts, immutable revisions, evidence, and lineage are authoritative; serving projections are not",
    "new facets register descriptor versions and append typed long rows instead of widening subject tables",
    "identical payload bytes deduplicate while production attempts and assertions retain independent provenance",
    "deterministic low-cost mechanisms run before model-backed or high-disclosure mechanisms",
    "search similarity proposes candidates and never proves compatibility, licensing, safety, or correctness",
    "every skip, failure, escalation, abstention, publication, redirect, and verification decision emits a receipt",
    "model and classifier tiers cannot override explicit user or deterministic trigger tiers",
    "sealed benchmark artifacts cannot enter production ingestion, retrieval, primitive generation, or training"
  ],
  "waterfalls": [
