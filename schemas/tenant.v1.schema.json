{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.taedri.dev/codegraph/tenant.v1.schema.json",
  "title": "Taedri SaaS tenant v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["identity", "format_version", "slug", "display_name", "state", "created_at"],
  "properties": {
    "identity": {"type": "object"},
    "format_version": {"const": "1.0.0"},
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"
    },
    "display_name": {"type": "string", "minLength": 1},
    "state": {"enum": ["active", "suspended"]},
    "created_at": {"type": "string", "format": "date-time"}
  }
}
