{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.taedri.dev/codegraph/benchmark-run-receipt.v1.schema.json",
  "title": "Taedri benchmark run receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "identity", "format_version", "run_spec_id", "experiment_id", "task_id", "lane", "repetition", "seed",
    "evidence_class", "outcome", "contamination_state", "completed_at", "output_artifact_ref",
    "model_usage_receipt_ref", "verification_receipt_refs", "retrieved_refs", "materialized_refs", "tool_receipt_refs",
    "prompt_tokens", "completion_tokens", "cached_prompt_tokens", "tool_tokens", "disclosed_context_bytes",
    "materialized_source_bytes", "reused_source_bytes", "newly_authored_source_bytes", "wall_ms", "model_ms",
    "retrieval_ms", "verification_ms", "provider_cost_microunits", "infrastructure_cost_microunits", "model_attempts",
    "repair_turns", "tool_calls", "human_interventions", "tests_total", "tests_passed", "tests_failed", "tests_skipped",
    "build_passed", "policy_passed", "verification_passed", "output_digest", "behavior_digest", "failure_class"
  ],
  "properties": {
    "identity": {"type": "object"},
    "format_version": {"const": "1.0.0"},
    "run_spec_id": {"type": "string", "pattern": "^uceg:v1:.+"},
    "experiment_id": {"type": "string", "pattern": "^uceg:v1:.+"},
    "task_id": {"type": "string", "pattern": "^uceg:v1:.+"},
    "lane": {"enum": ["bare_model", "search_context", "primitive_plan", "primitive_materialized"]},
    "repetition": {"type": "integer", "minimum": 1},
    "seed": {"type": "integer"},
    "evidence_class": {"enum": ["conformance_fixture", "real_model"]},
    "outcome": {"enum": ["passed", "failed", "abstained", "policy_blocked", "infra_error"]},
    "contamination_state": {"enum": ["clean", "detected", "unknown"]},
    "completed_at": {"type": "string", "format": "date-time"},
    "output_artifact_ref": {"$ref": "#/$defs/nullableRef"},
    "model_usage_receipt_ref": {"$ref": "#/$defs/nullableRef"},
    "verification_receipt_refs": {"$ref": "#/$defs/refArray"},
    "retrieved_refs": {"$ref": "#/$defs/refArray"},
    "materialized_refs": {"$ref": "#/$defs/refArray"},
    "tool_receipt_refs": {"$ref": "#/$defs/refArray"},
    "prompt_tokens": {"$ref": "#/$defs/count"},
    "completion_tokens": {"$ref": "#/$defs/count"},
    "cached_prompt_tokens": {"$ref": "#/$defs/count"},
    "tool_tokens": {"$ref": "#/$defs/count"},
    "disclosed_context_bytes": {"$ref": "#/$defs/count"},
    "materialized_source_bytes": {"$ref": "#/$defs/count"},
    "reused_source_bytes": {"$ref": "#/$defs/count"},
    "newly_authored_source_bytes": {"$ref": "#/$defs/count"},
    "wall_ms": {"$ref": "#/$defs/count"},
    "model_ms": {"$ref": "#/$defs/count"},
    "retrieval_ms": {"$ref": "#/$defs/count"},
    "verification_ms": {"$ref": "#/$defs/count"},
    "provider_cost_microunits": {"$ref": "#/$defs/count"},
    "infrastructure_cost_microunits": {"$ref": "#/$defs/count"},
    "model_attempts": {"$ref": "#/$defs/count"},
    "repair_turns": {"$ref": "#/$defs/count"},
    "tool_calls": {"$ref": "#/$defs/count"},
    "human_interventions": {"$ref": "#/$defs/count"},
    "tests_total": {"$ref": "#/$defs/count"},
    "tests_passed": {"$ref": "#/$defs/count"},
    "tests_failed": {"$ref": "#/$defs/count"},
    "tests_skipped": {"$ref": "#/$defs/count"},
    "build_passed": {"type": "boolean"},
    "policy_passed": {"type": "boolean"},
    "verification_passed": {"type": "boolean"},
    "output_digest": {"$ref": "#/$defs/nullableDigest"},
    "behavior_digest": {"$ref": "#/$defs/nullableDigest"},
    "failure_class": {"type": ["string", "null"]}
  },
  "$defs": {
    "count": {"type": "integer", "minimum": 0},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "anyRef": {"type": "string", "pattern": "^(sha256:|uceg:v1:|registry:|sealed:).+"},
    "nullableRef": {"oneOf": [{"$ref": "#/$defs/anyRef"}, {"type": "null"}]},
    "nullableDigest": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
    "refArray": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/anyRef"}}
  }
}
