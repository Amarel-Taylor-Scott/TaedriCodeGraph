{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.taedri.dev/codegraph/benchmark-experiment.v1.schema.json",
  "title": "Taedri matched-lane benchmark experiment v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "identity",
    "format_version",
    "name",
    "task_ids",
    "lanes",
    "seeds",
    "evidence_class",
    "provider_id",
    "model_id",
    "model_config_digest",
    "harness_digest",
    "retrieval_snapshot_ref",
    "primitive_registry_snapshot_ref",
    "sandbox_image_digest",
    "policy_digest",
    "network_policy",
    "budget",
    "created_at"
  ],
  "properties": {
    "identity": {"type": "object"},
    "format_version": {"const": "1.0.0"},
    "name": {"type": "string", "minLength": 1},
    "task_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "lanes": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "contains": {"const": "bare_model"},
      "items": {"enum": ["bare_model", "search_context", "primitive_plan", "primitive_materialized"]}
    },
    "seeds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer"}},
    "evidence_class": {"enum": ["conformance_fixture", "real_model"]},
    "provider_id": {"type": "string", "minLength": 1},
    "model_id": {"type": "string", "minLength": 1},
    "model_config_digest": {"$ref": "#/$defs/digest"},
    "harness_digest": {"$ref": "#/$defs/digest"},
    "retrieval_snapshot_ref": {"$ref": "#/$defs/contentRef"},
    "primitive_registry_snapshot_ref": {"$ref": "#/$defs/contentRef"},
    "sandbox_image_digest": {"$ref": "#/$defs/digest"},
    "policy_digest": {"$ref": "#/$defs/digest"},
    "network_policy": {"enum": ["disabled", "benchmark_declared"]},
    "budget": {"$ref": "#/$defs/budget"},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "contentRef": {"type": "string", "pattern": "^(sha256:|uceg:v1:|registry:).+"},
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_prompt_tokens", "max_completion_tokens", "max_tool_calls", "max_wall_ms", "max_verifier_cpu_ms"],
      "properties": {
        "max_prompt_tokens": {"type": "integer", "minimum": 1},
        "max_completion_tokens": {"type": "integer", "minimum": 1},
        "max_tool_calls": {"type": "integer", "minimum": 0},
        "max_wall_ms": {"type": "integer", "minimum": 1},
        "max_verifier_cpu_ms": {"type": "integer", "minimum": 1}
      }
    }
  }
}
